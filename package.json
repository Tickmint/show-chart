{
  "name": "forex-chart-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint . --fix --cache --cache-strategy content --max-warnings=0",
    "format": "prettier --write --cache --cache-strategy content --log-level warn .",
    "verify:rules": "node verify-script/main.mjs",
    "strip:comments": "node verify-script/general/remove-comments.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run verify:rules && npm run strip:comments && npm run lint && npm run format && npm run test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache --cache-strategy content --max-warnings=0",
      "prettier --write --cache --cache-strategy content",
      "vitest related --run"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write --cache --cache-strategy content"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "^1.16.0",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
